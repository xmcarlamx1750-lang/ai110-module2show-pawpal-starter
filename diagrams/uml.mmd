classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +bool completed
        +mark_complete() void
        +priority_rank() int
    }

    class Scheduler {
        +Owner owner
        +date date
        +build_plan() list
        +explain_plan() str
        +fits_in_time(task, minutes_used) bool
    }

    Owner "1" *-- "1..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : uses
    Scheduler ..> Task : schedules
