classDiagram
    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str time
        +str frequency
        +bool completed
        +date due_date
        +mark_complete() void
        +next_occurrence() Task
        +priority_rank() int
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +complete_task(task) Task
        +pending_tasks() list~Task~
    }

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +Owner owner
        +date date
        +list~Task~ plan
        +list~Task~ skipped
        +get_pending_tasks() list~Task~
        +filter_tasks(completed, pet_name) list~Task~
        +sort_tasks(tasks) list~Task~
        +sort_by_time(tasks) list~Task~
        +detect_conflicts() list~str~
        +fits_in_time(task, minutes_used) bool
        +build_plan() list~Task~
        +explain_plan() str
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Pet ..> Task : creates next occurrence
    Task ..> Task : next_occurrence()
    Scheduler --> "1" Owner : plans for
    Scheduler ..> Pet : reads pending tasks
    Scheduler --> "0..*" Task : plan / skipped
